# Copie este arquivo para ".env" (ou configure as variáveis diretamente no serviço de
# hospedagem escolhido) e preencha com os valores reais. NUNCA versione o ".env" real
# nem o arquivo da service account no Git.

# --- Credenciais do Google (obrigatório) ---
# Opção A: caminho para o arquivo JSON da service account (recomendado em produção)
GOOGLE_SERVICE_ACCOUNT_FILE=/caminho/seguro/para/service-account.json
# Opção B: o conteúdo do JSON inline (alternativa, ex: variável secreta na hospedagem)
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}

# --- Autenticação do app (obrigatório) ---
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
APP_USERNAME=ricardo
# Gere com: node -e "const{hashPassword}=await import('./dist/server/auth/password.js');console.log(hashPassword('SUA_SENHA'))"
APP_PASSWORD_HASH=scrypt$...$...

# --- Planilha (opcional — já tem valores padrão apontando pra planilha real) ---
# SPREADSHEET_ID=1ALKfPUPfywf1n6Y0hTlbLmmre7KAU48v-yXvvcQw19E
# ORDERS_SHEET_NAME=Respostas ao formulário 1
# EDITS_SHEET_NAME=Edições
# EXPENSES_SHEET_NAME=Financeiro

# --- Outros (opcional) ---
# PORT=3000
# AUTO_SYNC_INTERVAL_MS=300000
